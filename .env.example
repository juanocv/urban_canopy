# Google Street View / Geocoding. Required only for real API calls; importing
# the package and running the unit suite never touches the network.
GOOGLE_API_KEY=

# Logging
UC_DEBUG=0
UC_LOG_LEVEL=INFO
UC_LOG_FORMAT=text
UC_LOG_FILE=

# Segmentation defaults
UC_SEG_BACKEND=oneformer

# Image loading: the Street View watermark strip is excluded from the valid
# pixel count when this is > 0. Keep it identical across a whole study.
UC_IMG_EXCLUDE_BOTTOM_PX=0

# Web API
UC_API_MAX_CONCURRENCY=1
UC_API_QUEUE_TIMEOUT_S=300
UC_API_CORS_ORIGINS=*

# Model caches
TORCH_HOME=
HF_HOME=
