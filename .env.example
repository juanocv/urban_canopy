# Google Street View / Geocoding. Required only for real API calls; importing
# the package and running the unit suite never touches the network.
GOOGLE_API_KEY=

# Logging
UC_DEBUG=0
UC_LOG_LEVEL=INFO
UC_LOG_FORMAT=text
UC_LOG_FILE=

# Segmentation defaults
UC_SEG_BACKEND=oneformer

# DeepLab backend. These are properties of the machine, not of a run: set them
# once and --ckpt / --deeplab-repo / --deeplab-model become optional, still
# overriding when passed on the command line.
UC_DEEPLAB_CKPT=
UC_DEEPLAB_REPO=
UC_DEEPLAB_MODEL=

# Web API
UC_API_MAX_CONCURRENCY=1
UC_API_QUEUE_TIMEOUT_S=300
UC_API_CORS_ORIGINS=*

# Model caches
TORCH_HOME=
HF_HOME=
